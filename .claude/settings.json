{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go mod tidy)",
      "Bash(make check)",
      "Bash(make lint*)",
      "Bash(make test*)",
      "Bash(make cover*)",
      "Bash(make fmt)",
      "Bash(make generate-mocks)",
      "Bash(make regenerate-mocks)",
      "Bash(make -C backend *)",
      "Bash(golangci-lint run*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm format*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test*)",
      "Bash(pnpm build)",
      "Bash(pnpm check)"
    ],
    "ask": [
      "Edit(**/*_test.go)",
      "Edit(**/*.test.ts)",
      "Edit(**/*.test.tsx)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(backend/internal/domain/ports/mocks/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/tests-green-gate.sh\""
          }
        ]
      }
    ]
  }
}
